#!/bin/sh
# bin/axiom — portable launcher for the Axiom CLI using uv (no activation or PYTHONPATH required).
#
# From inside the project (or anywhere if you add the bin/ dir to your PATH):
#   ./bin/axiom --help
#   ./bin/axiom axt compile --input ... --output ...
#
# Works in bash, zsh, fish, etc.
# After the one-time `uv sync --python 3.14 --extra dev`,
# this (or the global fish setup) gives you the `axiom` command that feels native.
#
# Implementation note: runs the project venv Python directly with src/ on
# PYTHONPATH rather than depending on the generated console-script shim. This is
# resilient to uv/hatchling editable install edge cases that can cause
# "ModuleNotFoundError: No module named 'hcaps'" from generated shims.

set -e

# Robust project dir resolution that survives symlinks (important if you symlink
# this script into ~/.local/bin or similar for a "global" feel).
script="$0"
while [ -L "$script" ]; do
  script_dir=$(cd -P "$(dirname "$script")" 2>/dev/null && pwd)
  target=$(readlink "$script" 2>/dev/null || readlink -f "$script" 2>/dev/null || echo "$script")
  case "$target" in
    /*) script="$target" ;;
    *)  script="$script_dir/$target" ;;
  esac
done
project_dir=$(cd -P "$(dirname "$script")/.." && pwd)
venv_python="$project_dir/.venv/bin/python"

if [ ! -x "$venv_python" ]; then
  echo "Axiom: creating local Python environment..." >&2
  uv sync --project "$project_dir" --python 3.14 --extra dev >&2
fi

cd "$project_dir"
if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$project_dir/src:$PYTHONPATH"
else
  export PYTHONPATH="$project_dir/src"
fi

# Use python -c + argv rewrite so that --help and error messages show
# "Usage: axiom ..." (not "python -m hcaps.cli").
exec "$venv_python" -c '
import sys
from hcaps.cli import app
sys.argv = ["axiom"] + sys.argv[1:]
sys.exit(app())
' -- "$@"
