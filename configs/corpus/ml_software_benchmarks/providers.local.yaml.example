providers:
  cache:
    root_path: ../../../.cache/axiom/providers
    mode: live
  primary:
    provider_id: local_openai_compatible
    type: openai_compatible
    provider_family: openai_compatible
    provider_mode: local
    base_url: http://localhost:8000/v1
    model: local-extractor-model
    api_key_env: AXIOM_LOCAL_PROVIDER_KEY
    dry_run: true
  escalation:
    provider_id: deterministic_fallback
    type: deterministic
    provider_family: deterministic
    provider_mode: deterministic
    model: deterministic-bootstrap-v0.2
  cascade:
    enabled: true
    gate:
      min_confidence: 0.72
      high_impact_claim_types:
        - causal_claim
        - measurement_claim
      max_escalation_fraction: 0.2
